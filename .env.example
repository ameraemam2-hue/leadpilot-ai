# =====================================================================
# LeadPilot AI — Environment Variables (Phase 1)
# Copy this file to `.env.local` and fill in your values.
# NEVER commit .env.local — it's git-ignored.
# =====================================================================

# ---- Supabase (from Project Settings > API in Supabase dashboard) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key

# Server-only (NEVER expose to the browser). Used by server actions / API routes.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key

# ---- Site URL ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =====================================================================
# Edge Function secrets — set these in Supabase, NOT in .env.local
# Run:
#   supabase secrets set CLAUDE_API_KEY=sk-ant-...
#   supabase secrets set CLAUDE_MODEL=claude-sonnet-4-20250514
# =====================================================================
